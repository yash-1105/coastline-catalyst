# Copy to .env.local for development, and set the same keys in Vercel for production.

# Canonical base URL. Used for metadata, sitemap and robots.
NEXT_PUBLIC_SITE_URL=https://coastlinecatalyst.com

# ---------------------------------------------------------------------------
# Form delivery. The first configured transport wins.
# With none of these set, submissions are written to .submissions/ in dev and
# fail with a clear error in production, so nothing is ever silently dropped.
# ---------------------------------------------------------------------------

# 1. Webhook (Zapier, Make, n8n, your own endpoint). Receives JSON; the deck
#    arrives as { deck: { filename, contentType, base64 } }.
PITCH_WEBHOOK_URL=
CONTACT_WEBHOOK_URL=

# 2. Email via Resend. FROM_EMAIL must be on a domain verified with Resend.
RESEND_API_KEY=
NOTIFY_EMAIL=hello@coastlinecatalyst.com
FROM_EMAIL=website@coastlinecatalyst.com

# ---------------------------------------------------------------------------
# reCAPTCHA v2 checkbox. Leave both blank to show the placeholder slot and
# skip server-side verification.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# ---------------------------------------------------------------------------
# Analytics and Search Console. Nothing loads while these are blank.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
