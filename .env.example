# Copy to .env.local for development, and set the same keys in Vercel.
# NEXT_PUBLIC_* is inlined into the browser bundle. Everything else is
# server only and must never gain that prefix.

# --- Site -------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://coastlinecatalyst.com

# --- Supabase ---------------------------------------------------------------
# BROWSER SAFE. Project URL and the anon key, which has zero database
# permissions here: RLS is on with no policies, so anon can read and write
# nothing. Used only to upload a deck to a signed URL.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY. Bypasses RLS entirely. If this reaches a browser, every pitch
# deck and contact message is readable by anyone. No NEXT_PUBLIC_ prefix, ever.
SUPABASE_SERVICE_ROLE_KEY=

# --- Cloudflare Turnstile ---------------------------------------------------
# BROWSER SAFE.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# SERVER ONLY.
TURNSTILE_SECRET_KEY=

# --- Cron -------------------------------------------------------------------
# SERVER ONLY. Bearer secret for /api/cron/maintenance. Generate with:
#   openssl rand -hex 32
CRON_SECRET=

# --- Analytics and Search Console -------------------------------------------
# Nothing loads while these are blank.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
